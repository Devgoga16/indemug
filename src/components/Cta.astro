---
import { cta } from '../data/site';
---

<section class="section">
  <div class="container">
    <div class="box reveal">
      <div class="copy">
        <h2 class="section-title">{cta.title}</h2>
        <p>{cta.text}</p>
        <a class="btn" href={cta.button.href} target="_blank" rel="noopener">
          {cta.button.label}<span class="arrow">→</span>
        </a>
        <small>✓ {cta.note}</small>
      </div>
      <div class="badge">{cta.badge}</div>
      <div class="art">
        <img src={cta.image} alt="Sillón amarillo en una sala moderna" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .box {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: clamp(32px, 5vw, 56px) clamp(20px, 5vw, 72px);
    border-radius: var(--radius-lg);
    background: linear-gradient(120deg, #fde6d6 0%, #fbeee5 60%, #f7e2d3 100%);
    overflow: hidden;
  }

  .copy {
    display: grid;
    gap: 14px;
    justify-items: start;
  }

  .copy p {
    color: var(--muted);
    font-size: 14px;
    max-width: 380px;
  }

  small {
    font-size: 12px;
    color: var(--muted);
  }

  .badge {
    background: #f7c948;
    border-radius: 14px;
    padding: 14px 18px;
    font-size: 13px;
    font-weight: 500;
    max-width: 160px;
    box-shadow: var(--shadow);
    transform: rotate(-3deg);
  }

  .art {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 1;
    justify-self: end;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(120, 60, 20, 0.15);
    transform: rotate(2deg);
  }

  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 860px) {
    .box {
      grid-template-columns: 1fr;
    }
    .art {
      justify-self: center;
    }
  }
</style>
