---
import { about } from '../data/site';
---

<section class="section" id="nosotros">
  <div class="container">
    <div class="banner reveal">
      <img src={about.image} alt="Sala con sofá y plantas" loading="lazy" />
    </div>

    <h2 class="section-title title reveal">{about.title}</h2>
    <p class="lead reveal">{about.text}</p>

    <h3 class="reasons-title reveal">{about.reasonsTitle}</h3>
    <ol class="reasons">
      {about.reasons.map((r, i) => (
        <li class="reveal" style={`transition-delay:${i * 80}ms`}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h4>{r.title}</h4>
          <p>{r.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .banner {
    border-radius: var(--radius-lg);
    overflow: hidden;
    height: clamp(200px, 30vw, 360px);
    margin-inline: clamp(0px, 4vw, 48px);
  }

  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    display: block;
  }

  .title {
    text-align: center;
    margin-top: clamp(32px, 5vw, 48px);
  }

  .lead {
    max-width: 760px;
    margin: 18px auto 0;
    text-align: center;
    color: var(--muted);
  }

  .reasons-title {
    text-align: center;
    font-size: 22px;
    margin-top: clamp(40px, 6vw, 64px);
  }

  .reasons {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 3vw, 40px);
    padding-inline: clamp(0px, 4vw, 48px);
  }

  .num {
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
  }

  h4 {
    margin: 10px 0 8px;
    font-size: 15px;
    font-weight: 600;
  }

  .reasons p {
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .reasons {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .reasons {
      grid-template-columns: 1fr;
    }
  }
</style>
