---
import { about } from '../data/site';
---

<section class="section" id="nosotros">
  <div class="container">
    <div class="banner reveal" aria-hidden="true">
      <svg viewBox="0 0 1000 300" preserveAspectRatio="xMidYMax slice">
        <rect width="1000" height="300" fill="#f1ede8" />
        <rect y="236" width="1000" height="64" fill="#e3dcd2" />
        <rect y="232" width="1000" height="5" fill="#fff" />
        <!-- planta izq -->
        <path d="M150 236l6-44h36l6 44z" fill="#d9cfc2" />
        <path d="M174 192V80" stroke="#6b5440" stroke-width="3" />
        <g fill="#6f8f57">
          <circle cx="174" cy="80" r="34" /><circle cx="148" cy="110" r="26" /><circle cx="200" cy="108" r="28" />
          <circle cx="172" cy="130" r="22" />
        </g>
        <!-- sofá -->
        <rect x="330" y="140" width="340" height="66" rx="20" fill="#e9e3da" />
        <rect x="312" y="168" width="56" height="62" rx="16" fill="#e2dbd1" />
        <rect x="632" y="168" width="56" height="62" rx="16" fill="#e2dbd1" />
        <rect x="356" y="190" width="288" height="38" rx="10" fill="#efeae3" stroke="#ddd5ca" />
        <path d="M500 190v38" stroke="#ddd5ca" />
        <rect x="380" y="150" width="70" height="44" rx="12" fill="#fbf9f6" />
        <rect x="550" y="150" width="70" height="44" rx="12" fill="#fbf9f6" />
        <path d="M330 230v6M670 230v6" stroke="#8b6a4c" stroke-width="4" />
        <!-- mesa lateral -->
        <rect x="720" y="196" width="50" height="6" rx="2" fill="#a5683d" />
        <path d="M730 202l-4 34M760 202l4 34" stroke="#a5683d" stroke-width="3" />
        <rect x="738" y="176" width="14" height="20" rx="3" fill="#fff" />
        <!-- planta der -->
        <path d="M820 236l4-36h30l4 36z" fill="#d9cfc2" />
        <g fill="#5f7d4a">
          <ellipse cx="840" cy="150" rx="12" ry="44" transform="rotate(-18 840 150)" />
          <ellipse cx="862" cy="160" rx="12" ry="40" transform="rotate(28 862 160)" />
          <ellipse cx="822" cy="168" rx="10" ry="34" transform="rotate(-48 822 168)" />
        </g>
      </svg>
    </div>

    <h2 class="section-title title reveal">{about.title}</h2>
    <p class="lead reveal">{about.text}</p>

    <h3 class="reasons-title reveal">{about.reasonsTitle}</h3>
    <ol class="reasons">
      {about.reasons.map((r, i) => (
        <li class="reveal" style={`transition-delay:${i * 80}ms`}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h4>{r.title}</h4>
          <p>{r.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .banner {
    border-radius: var(--radius-lg);
    overflow: hidden;
    height: clamp(200px, 30vw, 360px);
    margin-inline: clamp(0px, 4vw, 48px);
  }

  .banner svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .title {
    text-align: center;
    margin-top: clamp(32px, 5vw, 48px);
  }

  .lead {
    max-width: 760px;
    margin: 18px auto 0;
    text-align: center;
    color: var(--muted);
  }

  .reasons-title {
    text-align: center;
    font-size: 22px;
    margin-top: clamp(40px, 6vw, 64px);
  }

  .reasons {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 3vw, 40px);
    padding-inline: clamp(0px, 4vw, 48px);
  }

  .num {
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
  }

  h4 {
    margin: 10px 0 8px;
    font-size: 15px;
    font-weight: 600;
  }

  .reasons p {
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .reasons {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .reasons {
      grid-template-columns: 1fr;
    }
  }
</style>
