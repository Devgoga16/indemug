---
import { hero } from '../data/site';
---

<section class="hero" id="inicio">
  <div class="content container">
    <h1>{hero.title}</h1>
    <p>{hero.text}</p>
    <div class="ctas">
      <a class="btn" href={hero.primary.href} target="_blank" rel="noopener">
        {hero.primary.label}<span class="arrow">→</span>
      </a>
      <a class="btn btn-ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
    </div>
  </div>

  <!-- Escena ilustrada: reemplazable por una foto de fondo (ver README). -->
  <svg class="scene" viewBox="0 0 1440 420" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <defs>
      <linearGradient id="floor" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#c98b55" />
        <stop offset="1" stop-color="#a86a3c" />
      </linearGradient>
      <linearGradient id="wood" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#a5683d" />
        <stop offset="1" stop-color="#7d4a28" />
      </linearGradient>
    </defs>
    <rect y="330" width="1440" height="90" fill="url(#floor)" />
    <g stroke="rgba(0,0,0,.08)">
      <path d="M0 352h1440M0 378h1440M0 402h1440" />
    </g>
    <rect y="326" width="1440" height="6" fill="#e8dfd2" />

    <!-- lámpara colgante -->
    <path d="M430 0v120" stroke="#2a2522" stroke-width="2" />
    <path d="M400 150l30-32 30 32z" fill="#d6a46a" />
    <ellipse cx="430" cy="152" rx="10" ry="4" fill="#ffe9b8" />

    <!-- cama -->
    <rect x="560" y="150" width="320" height="150" rx="6" fill="url(#wood)" />
    <rect x="578" y="168" width="284" height="112" rx="3" fill="rgba(0,0,0,.18)" />
    <rect x="520" y="300" width="400" height="44" rx="4" fill="url(#wood)" />
    <rect x="528" y="268" width="384" height="40" rx="12" fill="#f4f1ec" />
    <rect x="560" y="240" width="140" height="40" rx="16" fill="#fff" />
    <rect x="740" y="240" width="140" height="40" rx="16" fill="#fff" />
    <path d="M700 272h212v36H700z" fill="#6f7a84" />
    <path d="M700 272c40 10 80 6 110 0v36H700z" fill="#5d6871" />

    <!-- veladores -->
    <rect x="440" y="280" width="70" height="52" rx="3" fill="url(#wood)" />
    <path d="M446 304h58" stroke="rgba(0,0,0,.2)" />
    <rect x="930" y="280" width="70" height="52" rx="3" fill="url(#wood)" />
    <path d="M936 304h58" stroke="rgba(0,0,0,.2)" />
    <path d="M965 280v-40" stroke="#2a2522" stroke-width="2" />
    <path d="M948 240h34l-6-26h-22z" fill="#f4efe6" />
    <rect x="456" y="262" width="12" height="18" rx="2" fill="#f4efe6" />

    <!-- planta -->
    <path d="M1170 332l8-56h44l8 56z" fill="#e8dfd2" />
    <g fill="#5f7d4a">
      <ellipse cx="1200" cy="220" rx="18" ry="46" transform="rotate(-20 1200 220)" />
      <ellipse cx="1176" cy="236" rx="14" ry="40" transform="rotate(-50 1176 236)" />
      <ellipse cx="1226" cy="232" rx="14" ry="40" transform="rotate(35 1226 232)" />
      <ellipse cx="1206" cy="196" rx="12" ry="34" transform="rotate(10 1206 196)" />
    </g>
    <g fill="#6f8f57">
      <ellipse cx="1190" cy="250" rx="10" ry="28" transform="rotate(-70 1190 250)" />
      <ellipse cx="1216" cy="254" rx="10" ry="28" transform="rotate(70 1216 254)" />
    </g>

    <!-- alfombra -->
    <path d="M470 344h500l50 60H420z" fill="#e7e2da" opacity=".85" />
    <path d="M488 352h464M470 372h500M452 392h536" stroke="#d3cbc0" />

    <!-- banco pequeño -->
    <rect x="240" y="292" width="74" height="40" rx="6" fill="#e1d6c6" />
    <path d="M232 260h90v10h-90z" fill="#c98b55" />
    <circle cx="262" cy="248" r="12" fill="#7c8c63" />
    <rect x="256" y="252" width="12" height="10" fill="#e8dfd2" />
  </svg>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 780px);
    background: radial-gradient(120% 80% at 50% 0%, #3b5c80 0%, var(--wall) 55%, #26405b 100%);
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    overflow: hidden;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  .content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-top: clamp(120px, 16vh, 170px);
  }

  h1 {
    font-size: clamp(38px, 6.4vw, 76px);
    letter-spacing: -0.01em;
    animation: rise 0.9s ease both;
  }

  p {
    max-width: 520px;
    margin: 18px auto 0;
    font-size: 16px;
    opacity: 0.85;
    animation: rise 0.9s 0.15s ease both;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
    animation: rise 0.9s 0.3s ease both;
  }

  .scene {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 56%;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 640px;
    }
    .scene {
      height: 44%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1,
    p,
    .ctas {
      animation: none;
    }
  }
</style>
