---
import { hero } from '../data/site';
---

<section class="hero" id="inicio">
  <div class="content container">
    <h1>{hero.title}</h1>
    <p>{hero.text}</p>
    <div class="ctas">
      <a class="btn" href={hero.primary.href} target="_blank" rel="noopener">
        {hero.primary.label}<span class="arrow">→</span>
      </a>
      <a class="btn btn-ghost" href={hero.secondary.href}>{hero.secondary.label}</a>
    </div>
  </div>

  <img class="bg" src={hero.image} alt="" fetchpriority="high" decoding="async" />
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 780px);
    background: radial-gradient(120% 80% at 50% 0%, #3b5c80 0%, var(--wall) 55%, #26405b 100%);
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    overflow: hidden;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  .content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-top: clamp(120px, 16vh, 170px);
  }

  h1 {
    font-size: clamp(38px, 6.4vw, 76px);
    letter-spacing: -0.01em;
    animation: rise 0.9s ease both;
  }

  p {
    max-width: 520px;
    margin: 18px auto 0;
    font-size: 16px;
    opacity: 0.92;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
    animation: rise 0.9s 0.15s ease both;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
    animation: rise 0.9s 0.3s ease both;
  }

  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
    animation: zoom 14s ease-out both;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 34, 48, 0.82) 0%, rgba(20, 34, 48, 0.58) 50%, rgba(20, 34, 48, 0.15) 100%);
  }

  @keyframes zoom {
    from {
      transform: scale(1.08);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 640px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1,
    p,
    .ctas,
    .bg {
      animation: none;
    }
  }
</style>
