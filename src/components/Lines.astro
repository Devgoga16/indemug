---
import Media from './Media.astro';
import { lines } from '../data/site';
---

<section class="section">
  <div class="container">
    <div class="panel reveal">
      <div class="head">
        <h2 class="section-title">{lines.title}</h2>
        <a class="more" href={lines.link.href}>{lines.link.label} ›</a>
      </div>
      <ul class="grid">
        {lines.items.map((item) => (
          <li class="card">
            <div class="thumb">
              <Media kind={item.kind} image={item.image} alt={item.name} />
            </div>
            <h3>{item.name}</h3>
            <span>{item.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;
  }

  .head h2 {
    flex: 1;
    text-align: center;
  }

  .more {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }

  .more:hover {
    color: var(--accent);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }

  .card {
    background: #fff;
    border-radius: var(--radius);
    padding: 14px 12px 16px;
    text-align: center;
    box-shadow: var(--shadow);
    transition: transform 0.25s ease;
  }

  .card:hover {
    transform: translateY(-4px);
  }

  .thumb {
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 12px;
  }

  h3 {
    font-size: 16px;
  }

  span {
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 560px) {
    .head {
      flex-direction: column;
      align-items: center;
    }
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
</style>
